{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "numa-money.vercel.app"
        }
      ],
      "destination": "https://qoomia.vercel.app/:path*",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/recurring/run",
      "schedule": "10 0 * * *"
    }
  ],
  "installCommand": "npm install --no-audit --no-fund"
}
