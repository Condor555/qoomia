{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "numa-money.vercel.app"
        }
      ],
      "destination": "https://qoomia.vercel.app/:path*",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/recurring/run",
      "schedule": "15 5 * * *"
    }
  ]
}

